model {
  extend autonotes.backend {
    apiControllers = component 'REST Controllers' {
      description 'AuthController, NoteController, UserController, SystemController'
      technology 'Spring Web'
    }

    security = component 'Security (JWT)' {
      description 'SecurityConfig, JwtRequestFilter, JwtService'
      technology 'Spring Security'
    }

    notesCore = component 'Notes Core' {
      description 'NoteFacade, NoteService, list/detail/create/delete use-cases'
      technology 'Spring Service, JPA'
    }

    outboxPublisher = component 'Outbox Publisher' {
      description 'Публикация событий из outbox_events по расписанию'
      technology 'Spring @Scheduled'
    }

    resultConsumer = component 'Result Consumer' {
      description 'Получение NoteResultDto из notes.results.queue'
      technology 'Spring AMQP'
    }

    filestorage = component 'File Storage' {
      description 'Upload/delete файлов в MinIO + валидация типа'
      technology 'S3 SDK, Apache Tika'
    }

    notesMaintenance = component 'Notes Maintenance' {
      description 'Cleanup soft-delete, processing timeout, orphaned files'
      technology 'Scheduled jobs'
    }

    userAuth = component 'User/Auth Module' {
      description 'Регистрация, логин, профиль'
      technology 'Spring Security, JPA'
    }

    messagingConfig = component 'RabbitMQ Config' {
      description 'Exchange/queues/bindings + templates/listeners'
      technology 'Spring AMQP'
    }

    security -> apiControllers 'auth filter chain'
    apiControllers -> notesCore 'notes API'
    apiControllers -> userAuth 'auth/profile API'
    notesCore -> filestorage 'images'
    notesCore -> outboxPublisher 'event creation'
    outboxPublisher -> messagingConfig 'publish'
    messagingConfig -> autonotes.rabbitmq
    autonotes.rabbitmq -> resultConsumer 'completed event'
    resultConsumer -> notesCore 'apply ML result'
    notesCore -> autonotes.postgres
    userAuth -> autonotes.postgres
    filestorage -> autonotes.minio
    notesMaintenance -> autonotes.postgres
    notesMaintenance -> filestorage
  }
}
