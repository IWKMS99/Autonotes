views {

  dynamic view dynamic_auth {
    variant sequence
    title 'Dynamic - Auth flow'
    description 'Регистрация/логин пользователя через frontend и backend.'

    student -> autonotes.frontend.pagesLayer 'submit auth form'
    autonotes.frontend.pagesLayer -> autonotes.frontend.featuresLayer 'auth scenario'
    autonotes.frontend.featuresLayer -> autonotes.frontend.entitiesLayer 'auth use-case'
    autonotes.frontend.entitiesLayer -> autonotes.frontend.sharedApiClient
    autonotes.frontend.sharedApiClient -> autonotes.backend.apiControllers 'POST /api/v1/auth/*'
    autonotes.backend.apiControllers -> autonotes.backend.userAuth
    autonotes.backend.userAuth -> autonotes.postgres
    autonotes.backend.apiControllers -> autonotes.frontend.sharedApiClient 'JWT response'

    include
      student,
      autonotes.frontend.pagesLayer,
      autonotes.frontend.featuresLayer,
      autonotes.frontend.entitiesLayer,
      autonotes.frontend.sharedApiClient,
      autonotes.backend.apiControllers,
      autonotes.backend.userAuth,
      autonotes.postgres
  }

  dynamic view dynamic_create_note {
    variant sequence
    title 'Dynamic - Create note flow'
    description 'Upload изображений, асинхронная обработка и получение итогового конспекта.'

    student -> autonotes.frontend.widgetsLayer 'select images and title'
    autonotes.frontend.pagesLayer -> autonotes.frontend.featuresLayer 'start upload use-case'
    autonotes.frontend.featuresLayer -> autonotes.frontend.entitiesLayer 'create note + polling'
    autonotes.frontend.entitiesLayer -> autonotes.frontend.sharedApiClient
    autonotes.frontend.sharedApiClient -> autonotes.backend.apiControllers 'POST /api/v1/notes'
    autonotes.backend.apiControllers -> autonotes.backend.notesCore
    autonotes.backend.notesCore -> autonotes.backend.filestorage
    autonotes.backend.filestorage -> autonotes.minio 'S3 PUT'
    autonotes.backend.notesCore -> autonotes.postgres 'note + outbox'
    autonotes.backend.outboxPublisher -> autonotes.rabbitmq 'notes.created'
    autonotes.rabbitmq -> autonotes.mlWorker.processConsumer 'consume processing event'
    autonotes.mlWorker.processConsumer -> autonotes.mlWorker.s3Reader
    autonotes.mlWorker.s3Reader -> autonotes.minio 'S3 GET'
    autonotes.mlWorker.processConsumer -> autonotes.mlWorker.ocrPipeline
    autonotes.mlWorker.ocrPipeline -> autonotes.mlWorker.summarizer
    autonotes.mlWorker.summarizer -> autonotes.mlWorker.resultPublisher
    autonotes.mlWorker.resultPublisher -> autonotes.rabbitmq 'notes.completed'
    autonotes.rabbitmq -> autonotes.backend.resultConsumer
    autonotes.backend.resultConsumer -> autonotes.backend.notesCore 'apply result'
    autonotes.backend.notesCore -> autonotes.postgres 'update COMPLETED'

    include
      student,
      autonotes.frontend.pagesLayer,
      autonotes.frontend.widgetsLayer,
      autonotes.frontend.featuresLayer,
      autonotes.frontend.entitiesLayer,
      autonotes.frontend.sharedApiClient,
      autonotes.backend.apiControllers,
      autonotes.backend.notesCore,
      autonotes.backend.filestorage,
      autonotes.backend.outboxPublisher,
      autonotes.backend.resultConsumer,
      autonotes.mlWorker.processConsumer,
      autonotes.mlWorker.s3Reader,
      autonotes.mlWorker.ocrPipeline,
      autonotes.mlWorker.summarizer,
      autonotes.mlWorker.resultPublisher,
      autonotes.postgres,
      autonotes.minio,
      autonotes.rabbitmq
  }
}
