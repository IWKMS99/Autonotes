views {

  view c3_backend of autonotes.backend {
    title 'C3 - Backend Components'
    description 'API, security, notes, outbox publisher, result consumer, storage и maintenance.'
    include
      *,
      autonotes.postgres,
      autonotes.minio,
      autonotes.rabbitmq
  }

  view c3_frontend of autonotes.frontend {
    title 'C3 - Frontend Components'
    description 'FSD-слои frontend и API client для backend-взаимодействия.'
    include
      *,
      autonotes.backend
  }

  view c3_ml of autonotes.mlWorker {
    title 'C3 - ML Service Components'
    description 'Consumer -> S3 reader -> OCR -> summarizer -> result publisher.'
    include
      *,
      autonotes.rabbitmq,
      autonotes.minio
  }
}
