views {

  view c1_system_context {
    title 'C1 - System Context'
    description 'Пользователь взаимодействует с платформой Autonotes через web-интерфейс.'
    include
      student,
      autonotes,
      student -> autonotes
  }

  view c2_containers of autonotes {
    title 'C2 - Containers'
    description 'Контейнеры платформы: frontend, backend, ml, postgres, minio, rabbitmq.'
    include *
  }

  view c2_async_processing of autonotes {
    title 'C2 - Async Processing'
    description 'Асинхронная цепочка: outbox -> RabbitMQ -> ML -> result update.'
    include
      backend,
      rabbitmq,
      mlWorker,
      minio,
      postgres,
      backend -> postgres,
      backend -> minio,
      backend -> rabbitmq,
      rabbitmq -> mlWorker,
      mlWorker -> rabbitmq,
      mlWorker -> minio

    exclude
      student,
      frontend
  }
}
