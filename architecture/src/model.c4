model {

  student = actor 'Студент' {
    description '''
    Пользователь платформы: регистрируется, загружает фото,
    получает обработанный конспект и управляет заметками.
    '''
  }

  autonotes = system 'Autonotes Platform' {
    description '''
    Платформа автоматического создания конспектов из изображений.

    Поток: upload -> backend -> outbox -> RabbitMQ -> ML -> result -> backend -> UI.
    Надежность: Transactional Outbox + at-least-once доставка.
    '''

    frontend = webapp 'Frontend (React SPA)' {
      description '''
      UI для auth, списка заметок, загрузки изображений и просмотра результата.
      Архитектура: Feature-Sliced Design.
      '''
      technology 'React 19, Axios'
    }

    backend = service 'Backend API (Spring Boot)' {
      description '''
      REST API, auth, бизнес-логика notes, интеграция с MinIO и RabbitMQ,
      обработка результатов ML и фоновые задачи обслуживания данных.
      '''
      technology 'Java 24, Spring Boot 3.5'
    }

    mlWorker = service 'ML Service' {
      description '''
      Воркер обработки заметок: consume events из process queue,
      формирование результата и publish completed events.
      '''
      technology 'Python 3.12, FastAPI, aio-pika'
    }

    postgres = database 'PostgreSQL' {
      description 'users, notes, note_images, outbox_events'
      technology 'PostgreSQL 16, Flyway'
    }

    minio = storage 'MinIO (S3)' {
      description 'Хранение исходных изображений заметок'
      technology 'MinIO, AWS S3 SDK'
    }

    rabbitmq = queue 'RabbitMQ' {
      description '''
      Exchange: notes.exchange
      Queue processing: notes.process.queue
      Queue results: notes.results.queue
      '''
      technology 'RabbitMQ, Spring AMQP'
    }

    student -> frontend 'использует web-интерфейс'
    frontend -> backend 'REST /api/v1 (JWT)'

    backend -> postgres 'JPA/JDBC'
    backend -> minio 'S3 API upload/delete'
    backend -> rabbitmq 'publish NoteProcessingEvent, consume NoteResultDto'

    rabbitmq -> mlWorker 'consume notes.process.queue'
    mlWorker -> rabbitmq 'publish notes.results.queue'
    mlWorker -> minio 'read source images from S3'
  }

  student -> autonotes 'использует платформу'
}
