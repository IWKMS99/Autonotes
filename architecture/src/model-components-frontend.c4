model {
  extend autonotes.frontend {
    appEntry = component 'App Entry' {
      description 'app/App.js + providers.js'
      technology 'React 19'
    }

    appRouter = component 'App Router' {
      description 'app/router.js — routes + protected layout'
      technology 'react-router-dom'
    }

    sharedApiClient = component 'Shared API Client' {
      description 'shared/api/client.js — Axios + JWT interceptors'
      technology 'Axios'
    }

    pagesLayer = component 'Pages Layer' {
      description 'pages/* — screen composition only (no direct API)'
    }

    widgetsLayer = component 'Widgets Layer' {
      description 'widgets/* — reusable composed UI blocks'
    }

    featuresLayer = component 'Features Layer' {
      description 'features/*/model — use-cases: auth, dashboard polling, upload, detail, profile stats'
    }

    entitiesLayer = component 'Entities Layer' {
      description 'entities/* — domain API + DTO mapping (note, user)'
    }

    sharedLayer = component 'Shared Layer' {
      description 'shared/* — async-state contract, ui states, utils/constants'
    }

    appEntry -> appRouter
    appRouter -> pagesLayer
    pagesLayer -> widgetsLayer
    pagesLayer -> featuresLayer
    widgetsLayer -> sharedLayer
    featuresLayer -> entitiesLayer
    featuresLayer -> sharedLayer
    entitiesLayer -> sharedApiClient
    sharedApiClient -> autonotes.backend 'REST /api/v1'
  }
}
