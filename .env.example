# ==========================================
# 🚀 APP CONFIGURATION (Backend)
# ==========================================
# Внешний порт, на котором будет доступен бэкенд
APP_PORT=8080

# Секретный ключ для подписи JWT.
# ВАЖНО: В продакшене используйте длинную случайную строку (Base64).
JWT_SECRET=c2VjcmV0LWtleS1mb3ItYXV0b25vdGVzLWRldmVsb3BtZW50LW9ubHk=

# Время жизни токена в миллисекундах (86400000 = 24 часа)
JWT_EXPIRATION_MS=86400000

# --- Настройки планировщиков (Scheduler) ---

# 1. Очистка зависших задач (NoteCleanupService)
# Cron: проверка каждые 2 минуты
APP_CLEANUP_CRON='0 */2 * * * *'
# Тайм-аут: если статус PROCESSING висит дольше 10 минут -> ставим FAILED
APP_PROCESSING_TIMEOUT=10

# 2. Transactional Outbox (OutboxPublisherService)
# Интервал опроса базы данных для отправки событий в RabbitMQ (в мс)
APP_OUTBOX_INTERVAL=2000

# 3. S3 Garbage Collector (StorageCleanupService) - удаляет файлы без записей в БД
# Cron: запуск в 3:00 ночи
APP_S3_CLEANUP_CRON='0 0 3 * * *'
# Retention: сколько часов файл может лежать без записи в БД
APP_S3_RETENTION_HOURS=24

# 4. Recycle Bin Cleaner (SoftDeleteCleanupService) - удаляет записи из корзины
# Сколько дней хранить удаленные заметки перед физическим удалением
APP_SOFT_DELETE_RETENTION_DAYS=30
# Cron: запуск в 4:00 ночи
APP_SOFT_DELETE_CLEANUP_CRON='0 0 4 * * *'


# ==========================================
# 🗄️ DATABASE (PostgreSQL)
# ==========================================
# Внешний порт для подключения к БД
DB_PORT=5432
POSTGRES_USER=autonotes_user
POSTGRES_PASSWORD=autonotes_password
POSTGRES_DB=autonotes_db


# ==========================================
# OBJECT STORAGE (MinIO)
# ==========================================
# Внешние порты
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Учетные данные (root)
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Имя бакета для хранения изображений
MINIO_BUCKET=lecture-notes


# ==========================================
# MESSAGE BROKER (RabbitMQ)
# ==========================================
# Внешние порты
RABBITMQ_PORT=5672
RABBITMQ_CONSOLE_PORT=15672

# Учетные данные
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest


# ==========================================
# FRONTEND (React)
# ==========================================
# Базовый URL API для React-приложения
REACT_APP_API_BASE_URL=http://localhost:8080/api/v1

# ==========================================
# ML SERVICE
# ==========================================
ML_PORT=8000
PYTHONUNBUFFERED=1