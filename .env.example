# ==========================================
# Core App (Backend/Security)
# ==========================================
SERVER_PORT=8080
APP_PORT=8090
NGINX_LB_CONFIG=./nginx/nginx.single.conf
PROMETHEUS_SCRAPE_CONFIG=./monitoring/prometheus.single.yml
# COMPOSE_PROFILES=cluster
SPRING_JPA_HIBERNATE_DDL_AUTO=none
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# JWT (use strong random Base64 secret outside local dev)
JWT_SECRET=c2VjcmV0LWtleS1mb3ItYXV0b25vdGVzLWRldmVsb3BtZW50LW9ubHk=
JWT_EXPIRATION_MS=86400000

# ==========================================
# Scheduler
# ==========================================
APP_CLEANUP_CRON=0 */2 * * * *
APP_PROCESSING_TIMEOUT=10
APP_OUTBOX_INTERVAL=2000
APP_S3_CLEANUP_CRON=0 0 3 * * *
APP_S3_RETENTION_HOURS=24
APP_SOFT_DELETE_RETENTION_DAYS=30
APP_SOFT_DELETE_CLEANUP_CRON=0 0 4 * * *

# ==========================================
# PostgreSQL
# ==========================================
DB_PORT=5432
POSTGRES_USER=autonotes_user
POSTGRES_PASSWORD=autonotes_password
POSTGRES_DB=autonotes_db
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/${POSTGRES_DB}
SPRING_DATASOURCE_USERNAME=${POSTGRES_USER}
SPRING_DATASOURCE_PASSWORD=${POSTGRES_PASSWORD}

# ==========================================
# MinIO
# ==========================================
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=lecture-notes
MINIO_ENDPOINT=http://minio:9000

# ==========================================
# RabbitMQ
# ==========================================
RABBITMQ_PORT=5672
RABBITMQ_CONSOLE_PORT=15672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_HOST=rabbitmq

# ==========================================
# Observability
# ==========================================
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=admin
JAEGER_UI_PORT=16686
JAEGER_ZIPKIN_PORT=9411
JAEGER_OTLP_GRPC_PORT=4317
JAEGER_OTLP_HTTP_PORT=4318
KIBANA_PORT=5601
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_JAVA_OPTS=-Xms512m -Xmx512m

# ==========================================
# Frontend
# ==========================================
# Базовый URL API для React-приложения
REACT_APP_API_BASE_URL=http://localhost:8080/api/v1

# ==========================================
# ML SERVICE
# ==========================================
ML_PORT=8000
PYTHONUNBUFFERED=1

# Ollama (на хосте; из Docker — host.docker.internal)
# qwen2.5vl:3b — меньше RAM (~3 GiB); 7b требует ~5 GiB
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5vl:3b
OLLAMA_TIMEOUT_SEC=300
OLLAMA_MULTI_IMAGE_MODE=sequential
OLLAMA_ENABLE_SUMMARY=true
OLLAMA_FALLBACK_MODEL=qwen2.5vl:3b
